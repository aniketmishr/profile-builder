# Copy to .env for local runs without docker compose.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/profiles
SESSION_TOKEN_SECRET=change-me-to-a-long-random-string
PUBLIC_BASE_URL=http://localhost:8000
ENABLE_DEBUG_ENDPOINTS=true
LOG_LEVEL=INFO

# Optional: LLM (question planning, answer interpretation, extraction). Without it the app uses built-in fallbacks.
# LLM_PROVIDER=gemini
# LLM_MODEL=<current model id from Google AI Studio>
# GEMINI_API_KEY=
# Optional: voice answers. none | gemini | dev (dev returns a fixed stub transcript)
# STT_PROVIDER=gemini
# STT_MODEL=            # defaults to LLM_MODEL
